<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Call permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Storage permissions -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Hardware features -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Camverz"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:resizeableActivity="true"
        tools:targetApi="31">

        <!-- Login Activity (Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gender Selection Activity -->
        <activity
            android:name=".GenderSelectionActivity"
            android:exported="false" />

        <!-- Name Activity -->
        <activity
            android:name=".NameActivity"
            android:exported="false" />

        <!-- City Activity -->
        <activity
            android:name=".CityActivity"
            android:exported="false" />

        <!-- Birthday Activity -->
        <activity
            android:name=".BirthdayActivity"
            android:exported="false" />

        <!-- Finish Activity -->
        <activity
            android:name=".FinishActivity"
            android:exported="false" />

        <!-- Main Screen Activity -->
        <activity
            android:name=".MainScreenActivity"
            android:exported="false" />

        <!-- Connecting Activity -->
        <activity
            android:name=".ConnectingActivity"
            android:exported="false" />

        <!-- Call Activity (WebRTC Video Call) -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Verification Info Activity -->
        <activity
            android:name=".VerificationInfoActivity"
            android:exported="false" />

        <!-- Verification Activity -->
        <activity
            android:name=".VerificationActivity"
            android:exported="false" />

        <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
            
        <!-- Blocked Users Activity -->
        <activity
            android:name=".BlockedUsersActivity"
            android:exported="false" />

        <!-- Create Post Activity -->
        <activity
            android:name=".CreatePostActivity"
            android:exported="false" />

        <!-- Feed Activity -->
        <activity
            android:name=".FeedActivity"
            android:exported="false" />

        <activity
            android:name=".MessagingActivity"
            android:exported="false" />

        <activity
            android:name=".InboxActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationActivity"
            android:exported="false" />

        <activity
            android:name=".CommentsActivity"
            android:exported="false" />

        <activity
            android:name=".ChatActivity"
            android:exported="false" />


        <!-- AdMob Application ID (Test ID / Production loaded dynamically) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- AppLovin SDK Key (Commented out)
        <meta-data
            android:name="applovin.sdk.key"
            android:value="${applovinSdkKey}" />
        -->

    </application>

</manifest>
