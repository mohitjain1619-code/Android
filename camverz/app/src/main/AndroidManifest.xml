<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Call permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Storage permissions -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Hardware features -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".CamverzApp"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Camverz"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:resizeableActivity="true"
        tools:targetApi="31">

        <!-- Meta Audience Network Application ID -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <!-- Google Mobile Ads (AdMob) Application ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Login Activity (Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Language Selection Activity -->
        <activity
            android:name=".LanguageSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Gender Selection Activity -->
        <activity
            android:name=".GenderSelectionActivity"
            android:exported="false" />

        <!-- Name Activity -->
        <activity
            android:name=".NameActivity"
            android:exported="false" />

        <!-- City Activity -->
        <activity
            android:name=".CityActivity"
            android:exported="false" />

        <!-- Birthday Activity -->
        <activity
            android:name=".BirthdayActivity"
            android:exported="false" />

        <!-- Finish Activity -->
        <activity
            android:name=".FinishActivity"
            android:exported="false" />

        <!-- Main Screen Activity -->
        <activity
            android:name=".MainScreenActivity"
            android:exported="false" />

        <!-- Story Creator Activity -->
        <activity
            android:name=".StoryCreatorActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- Story Viewer Activity -->
        <activity
            android:name=".StoryViewerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Camverz.Fullscreen"
            android:exported="false" />

        <!-- Connecting Activity -->
        <activity
            android:name=".ConnectingActivity"
            android:exported="false" />

        <!-- Call Activity (WebRTC Video Call) -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Community Chat Activity -->
        <activity
            android:name=".CommunityChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Party Board Activity -->
        <activity
            android:name=".PartyBoardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Verification Info Activity -->
        <activity
            android:name=".VerificationInfoActivity"
            android:exported="false" />

        <!-- Verification Activity -->
        <activity
            android:name=".VerificationActivity"
            android:exported="false" />

        <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- Blocked Users Activity -->
        <activity
            android:name=".BlockedUsersActivity"
            android:exported="false" />

        <!-- Create Post Activity -->
        <activity
            android:name=".CreatePostActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <!-- Feed Activity -->
        <activity
            android:name=".FeedActivity"
            android:exported="false" />

        <activity
            android:name=".MessagingActivity"
            android:exported="false" />

        <activity
            android:name=".InboxActivity"
            android:exported="false" />

        <activity
            android:name=".CommunityInboxActivity"
            android:exported="false" />

        <activity
            android:name=".NotificationActivity"
            android:exported="false" />

        <activity
            android:name=".CommunityNotificationActivity"
            android:exported="false" />

        <activity
            android:name=".CommentsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Real Meet & Fantasy Community Activity -->
        <activity
            android:name=".RealMeetActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Legal & Policies Activity -->
        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Meta Interstitial Ad Testing Dashboard -->
        <activity
            android:name=".AdTestingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Camverz" />

    </application>

</manifest>
