<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Camverz Graphite -->
    <style name="Theme.Camverz" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_indigo</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/text_white</item>

        <!-- Application Window Background — Clean Light -->
        <item name="android:windowBackground">@color/bg_primary</item>

        <!-- Status Bar light icon control -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Popup Menu Theme Override (Dark surface background with bright text) -->
        <item name="popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:popupTheme">@style/CustomPopupMenuOverlay</item>
        <item name="popupTheme">@style/CustomPopupMenuOverlay</item>

        <!-- Global System Dialog Overrides (AlertDialog, TimePicker, DatePicker) -->
        <item name="android:alertDialogTheme">@style/CustomDarkAlertDialogTheme</item>
        <item name="alertDialogTheme">@style/CustomDarkAlertDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerTheme</item>
        <item name="android:timePickerDialogTheme">@style/CustomDatePickerTheme</item>
    </style>

    <style name="Theme.Camverz.Fullscreen" parent="Theme.Camverz">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="CustomPopupMenuOverlay" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@color/surface_dark</item>
    </style>

    <style name="ShapeAppearance.App.CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Global Dark AlertDialog Theme -->
    <style name="CustomDarkAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#D1D1D6</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/CustomMaterialAlertDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CustomMaterialAlertDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDialogNegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/CustomDialogNeutralButton</item>
    </style>

    <style name="CustomMaterialAlertDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomMaterialAlertDialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">#E5E7EB</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CustomDialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#FF6B5F</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomDialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#9CA3AF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomDialogNeutralButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#54D6D2</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.85</item>
    </style>

    <!-- Custom Dark Mode DatePicker / TimePicker Theme -->
    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorPrimaryInverse">@color/bg_dark</item>

        <!-- TimePicker & DatePicker Header & Numbers -->
        <item name="android:headerBackground">@color/surface_elevated</item>
        <item name="android:numbersTextColor">@color/text_white</item>
        <item name="android:numbersBackgroundColor">@color/surface_dark</item>
        <item name="android:numbersInnerTextColor">@color/text_white</item>
        <item name="android:numbersSelectorColor">@color/accent_cyan</item>

        <!-- Buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/CustomDatePickerButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDatePickerButton</item>
    </style>

    <style name="CustomDatePickerButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent_cyan</item>
    </style>
</resources>