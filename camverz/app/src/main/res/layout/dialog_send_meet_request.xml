<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0A0F"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Grab Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_luxury_handle" />

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="📩 Send Meet Request"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Connecting with post owner"
            android:textColor="#8E8E93"
            android:textSize="12sp" />

        <!-- Icebreaker Pills Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="QUICK ICEBREAKERS"
            android:textColor="#E5E5EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipIce1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_luxury_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="☕ Hey! I'd love to meet up for coffee"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipIce2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_luxury_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="🎉 Count me in! Let's connect!"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipIce3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_luxury_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="🔒 Loved your post, let's talk privately!"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Message Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="YOUR MESSAGE / NOTE"
            android:textColor="#E5E5EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRequestMessage"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_luxury_input"
            android:gravity="top|start"
            android:hint="Type your message or custom icebreaker..."
            android:inputType="textMultiLine"
            android:padding="13dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#636366"
            android:textSize="13sp" />

        <!-- Preferred Contact Mode -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PREFERRED CONTACT MODE"
            android:textColor="#E5E5EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrefVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_luxury_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="🎥 Video Call"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPrefChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_luxury_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="💬 Direct Chat"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Submit Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelReq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_luxury_pill_dark"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Cancel"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSendReq"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tactile_btn"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Send Request"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
