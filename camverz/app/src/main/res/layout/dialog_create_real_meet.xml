<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0A0F"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top Grab Handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_luxury_handle" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="📍 Post Real Meet"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Find people interested in meeting nearby today"
            android:textColor="#8E8E93"
            android:textSize="12sp" />

        <!-- Purpose / Reason -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PURPOSE OF MEET"
            android:textColor="#E5E5EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_luxury_input"
            android:hint="e.g. Coffee &amp; Casual Chat, Drive, Cinema..."
            android:inputType="textCapWords"
            android:padding="13dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#636366"
            android:textSize="13sp" />

        <!-- Location (Exact location / Landmark) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LOCATION / LANDMARK"
            android:textColor="#E5E5EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_luxury_input"
            android:hint="e.g. Third Wave Coffee near Indiranagar"
            android:inputType="textCapWords"
            android:padding="13dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#636366"
            android:textSize="13sp" />

        <!-- Time Picker Button (Clock) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MEETING TIME"
            android:textColor="#E5E5EA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnPickTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_luxury_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="13dp">

            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏰ Select Time (Tap to open Clock)"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒 CLOCK"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Description (200 Chars Limit) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="DESCRIPTION (MAX 200 LETTERS)"
                android:textColor="#E5E5EA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCharCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0 / 200"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </RelativeLayout>

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_luxury_input"
            android:gravity="top|start"
            android:hint="Describe why you want to meet up..."
            android:inputType="textMultiLine"
            android:maxLength="200"
            android:padding="13dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#636366"
            android:textSize="13sp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_luxury_pill_dark"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Cancel"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPublish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_luxury_pill_white"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Publish Post"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
