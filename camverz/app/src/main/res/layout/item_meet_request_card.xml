<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_glowing_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Applicant Info Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivApplicantAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_3"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_white_ring" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvApplicantNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Applicant Name, Age" />

            <TextView
                android:id="@+id/tvApplicantCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                tools:text="📍 City • Interested in your post" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_luxury_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#E5E5EA"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="PENDING" />
    </LinearLayout>

    <!-- Post Context Tag -->
    <TextView
        android:id="@+id/tvPostContext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_luxury_chip"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#F2F2F7"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="For: Post Purpose" />

    <!-- Message text -->
    <TextView
        android:id="@+id/tvRequestMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="#D1D1D6"
        android:textSize="12sp"
        tools:text="Applicant message..." />

    <!-- Contact Mode Preference Tag -->
    <TextView
        android:id="@+id/tvContactPreference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8E8E93"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="🎥 Prefers Video Call" />

    <!-- Direct Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStartCall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tactile_btn"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="🎥 Video Call"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnOpenChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_luxury_pill_dark"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="💬 Chat Now"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToggleAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_luxury_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:text="✅ Accept"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
