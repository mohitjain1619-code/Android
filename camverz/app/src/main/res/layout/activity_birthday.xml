<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="28dp">

    <ProgressBar
        android:id="@+id/progress4"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:progress="90"
        android:max="100"
        android:progressTint="@color/accent_primary"
        android:backgroundTint="@color/divider" />

    <TextView
        android:id="@+id/titleBirthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/progress4"
        android:layout_marginTop="40dp"
        android:text="When's your birthday?"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subBirthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleBirthday"
        android:layout_marginTop="8dp"
        android:text="You must be at least 18 to use Camverz"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/birthdayInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/subBirthday"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_glass_input"
        android:hint="DD / MM / YYYY"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="16sp"
        android:focusable="false"
        android:clickable="true" />

    <Button
        android:id="@+id/btnContinueBirthday"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_primary_gradient"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/backBtnBirthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</RelativeLayout>