<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0C29">

    <!-- Background Shine -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_premium_shine"
        android:alpha="0.8" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <ProgressBar
                android:id="@+id/progress4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="24dp"
                android:progress="95"
                android:max="100"
                android:progressTint="#00D9FF"
                android:backgroundTint="#33FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleBirthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:layout_marginTop="40dp"
            android:text="When is your birthday?"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#8000D9FF"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/subBirthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleBirthday"
            android:layout_marginTop="8dp"
            android:text="This helps match you with the right people"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/birthdayInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_glassy_edittext"
            android:hint="DD / MM / YYYY"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF"
            android:padding="18dp"
            android:layout_below="@id/subBirthday"
            android:layout_marginTop="40dp"
            android:focusable="false"
            android:clickable="true"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnContinueBirthday"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="24dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_neon_button_pill"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/backBtnBirthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </RelativeLayout>
</FrameLayout>