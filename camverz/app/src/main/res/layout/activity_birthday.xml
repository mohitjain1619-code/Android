<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_mesh"
    android:padding="24dp">

    <!-- Step Progress Header -->
    <LinearLayout
        android:id="@+id/progress_header_birthday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 3 of 4"
            android:textColor="#00FFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress4"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#40FFFFFF"
            android:max="100"
            android:progress="75"
            android:progressTint="#FF0080" />
    </LinearLayout>

    <!-- Header Container -->
    <LinearLayout
        android:id="@+id/headerContainerBirthday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/progress_header_birthday"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleBirthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="When's your birthday?"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subBirthday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="You must be at least 18 years old to use Camverz."
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- Floating Birthday Input Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerContainerBirthday"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_floating_glass"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feature_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🛡️ 18+ Age Restricted"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/birthdayInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glass_input"
            android:clickable="true"
            android:focusable="false"
            android:hint="DD / MM / YYYY"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Primary Continue Button -->
    <Button
        android:id="@+id/btnContinueBirthday"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_primary_gradient"
        android:stateListAnimator="@null"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/backBtnBirthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</RelativeLayout>