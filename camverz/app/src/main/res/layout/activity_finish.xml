<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_mesh"
    android:fillViewport="true"
    android:scrollbars="none">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Step Progress Header -->
        <LinearLayout
            android:id="@+id/progress_header_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 4 of 4"
                android:textColor="#00FFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressDone"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="#40FFFFFF"
                android:max="100"
                android:progress="100"
                android:progressTint="#FF0080" />
        </LinearLayout>

        <!-- Header Container -->
        <LinearLayout
            android:id="@+id/headerContainerFinish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/progress_header_finish"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You're all set!"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Review your profile and prepare to meet real people."
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- Summary Details Glass Card -->
        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerContainerFinish"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_floating_glass"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR PROFILE SUMMARY"
                android:textColor="#00FFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/finalName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_input"
                android:hint="Your Display Name"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/finalGender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_chip"
                    android:padding="12dp"
                    android:text="Gender: —"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/finalCity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feature_chip"
                    android:padding="12dp"
                    android:text="City: —"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/finalDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feature_chip"
                android:padding="12dp"
                android:text="Birthday: —"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Permissions & Privacy Glass Card -->
        <LinearLayout
            android:id="@+id/permissions_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/card"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero_card_glass"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS &amp; PRIVACY"
                android:textColor="#00FFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Camera &amp; Microphone: For live 1-on-1 video calls"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Geolocation: For nearby city &amp; country matching"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Zero-Recording: WebRTC calls are encrypted &amp; private"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Start Button -->
        <Button
            android:id="@+id/btnStartUsing"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/permissions_card"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_primary_gradient"
            android:stateListAnimator="@null"
            android:text="Start Video Chatting"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </RelativeLayout>
</ScrollView>