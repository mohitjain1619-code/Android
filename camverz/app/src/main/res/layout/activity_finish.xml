<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:padding="28dp">

    <TextView
        android:id="@+id/titleDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="You're all set!"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleDone"
        android:layout_marginTop="8dp"
        android:text="Review your details below"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- Summary Card -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/subDone"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_glass_card_luxury"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/finalName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_input"
            android:hint="Your name"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <TextView
            android:id="@+id/finalGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Gender: —"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/finalCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="City: —"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/finalDob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birthday: —"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStartUsing"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_btn_primary_gradient"
        android:text="Start Video Chatting"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</RelativeLayout>