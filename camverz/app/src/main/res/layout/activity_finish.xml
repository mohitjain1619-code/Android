<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0C29">

    <!-- Background Shine -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_premium_shine"
        android:alpha="0.8" />

    <RelativeLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"
            android:text="You're all set! 🎉"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#8000D9FF"
            android:shadowRadius="20" />

        <TextView
            android:id="@+id/subDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleDone"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:text="We've prepared your profile"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:padding="30dp"
            android:background="@drawable/bg_glass_item">

            <EditText
                android:id="@+id/finalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glassy_edittext"
                android:hint="Enter your name"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:imeOptions="actionDone"
                android:inputType="text" />

            <TextView
                android:id="@+id/finalGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Gender: ..."
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:shadowColor="#8000D9FF"
                android:shadowRadius="5" />

            <TextView
                android:id="@+id/finalCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="City: ..."
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:shadowColor="#8000D9FF"
                android:shadowRadius="5" />

            <TextView
                android:id="@+id/finalDob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birthday: ..."
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:shadowColor="#8000D9FF"
                android:shadowRadius="5" />

        </LinearLayout>

        <Button
            android:id="@+id/btnStartUsing"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_neon_button_pill"
            android:text="Start Chatting"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </RelativeLayout>
</FrameLayout>