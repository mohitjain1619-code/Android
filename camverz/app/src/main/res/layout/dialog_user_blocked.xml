<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_glass_card_luxury"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_close"
        app:tint="@color/accent_rose"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/titleBlocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Access Restricted"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/messageBlocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="This user has blocked you."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btn_ok"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_btn_primary_gradient"
        android:text="OK"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="@null"/>

</LinearLayout>