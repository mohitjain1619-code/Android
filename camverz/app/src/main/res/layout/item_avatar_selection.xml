<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/avatar_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/av1"
        app:civ_border_width="2dp"
        app:civ_border_color="#00E5FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/glow_effect"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/avatar_glowing_ring"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="@id/avatar_image"
        app:layout_constraintBottom_toBottomOf="@id/avatar_image"
        app:layout_constraintStart_toStartOf="@id/avatar_image"
        app:layout_constraintEnd_toEndOf="@id/avatar_image" />

</androidx.constraintlayout.widget.ConstraintLayout>
