<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ChatCallActivity">

    <!-- OUTGOING CALL LAYOUT -->
    <RelativeLayout
        android:id="@+id/layout_outgoing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/outgoing_avatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_user_placeholder"
                app:civ_border_width="2.5dp"
                app:civ_border_color="@color/accent_primary" />

            <TextView
                android:id="@+id/outgoing_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="User Name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/outgoing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Calling..."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_end_call_outgoing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="48dp"
            android:background="@drawable/bg_call_btn_red"
            android:src="@drawable/ic_call_end"
            android:padding="16dp"
            app:tint="@color/text_white"
            android:elevation="6dp" />
    </RelativeLayout>

    <!-- INCOMING CALL LAYOUT -->
    <RelativeLayout
        android:id="@+id/layout_incoming"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/incoming_avatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_user_placeholder"
                app:civ_border_width="3dp"
                app:civ_border_color="@color/accent_purple" />

            <TextView
                android:id="@+id/incoming_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.08"
                android:text="Incoming Video Call"
                android:textAllCaps="true"
                android:textColor="@color/accent_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incoming_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="User Name"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_reject_call"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_call_btn_red"
                android:src="@drawable/ic_call_end"
                android:padding="16dp"
                app:tint="@color/text_white"
                android:elevation="6dp"
                android:layout_marginEnd="40dp"/>

            <ImageButton
                android:id="@+id/btn_accept_call"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_btn_primary_gradient"
                android:src="@drawable/ic_video"
                android:padding="16dp"
                app:tint="@color/text_white"
                android:elevation="6dp"
                android:layout_marginStart="40dp"
                app:backgroundTint="@null"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- ACTIVE CALL LAYOUT -->
    <RelativeLayout
        android:id="@+id/layout_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Remote (Main) Video Renderer -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remote_view_renderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Local Video Window -->
        <FrameLayout
            android:id="@+id/local_view_container"
            android:layout_width="100dp"
            android:layout_height="140dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="16dp"
            android:elevation="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <org.webrtc.SurfaceViewRenderer
                    android:id="@+id/local_view_renderer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/swap_indicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_swap_vert"
                android:alpha="0.7"
                android:padding="4dp"
                android:background="@drawable/bg_swap_button"
                app:tint="@color/text_white"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Controls Container -->
        <RelativeLayout
            android:id="@+id/controls_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Bar with User Info and Follow Button -->
            <LinearLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#99000000"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="40dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/active_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_user_placeholder"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@color/accent_primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/active_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/call_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_follow"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_primary_gradient"
                    android:text="Follow"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>
            </LinearLayout>

            <!-- Bottom Controls Bar -->
            <LinearLayout
                android:id="@+id/bottom_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="#99000000"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="32dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_toggle_video"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round_white"
                    android:src="@drawable/ic_videocam_on"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:tint="#333333"
                    android:layout_marginEnd="12dp"
                    android:stateListAnimator="@null"/>

                <ImageButton
                    android:id="@+id/btn_mute"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round_white"
                    android:src="@drawable/ic_mic_on"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:tint="#333333"
                    android:layout_marginEnd="12dp"
                    android:stateListAnimator="@null"/>

                <ImageButton
                    android:id="@+id/btn_end_call_active"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_call_btn_red"
                    android:src="@drawable/ic_call_end"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    app:tint="@color/text_white"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"/>

                <ImageButton
                    android:id="@+id/btn_switch_camera"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_round_white"
                    android:src="@drawable/ic_camera_flip"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    app:tint="#333333"
                    android:layout_marginStart="12dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

</FrameLayout>
