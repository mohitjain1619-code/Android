<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Remote Video Off Overlay -->
    <RelativeLayout
        android:id="@+id/remote_avatar_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:visibility="gone">

        <ImageView
            android:id="@+id/remote_avatar_blur_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.15"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/remote_avatar_large"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_user_placeholder"
                app:civ_border_color="@color/accent_primary"
                app:civ_border_width="3dp" />

            <TextView
                android:id="@+id/remote_avatar_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="User"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Camera is off"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Local Video PiP -->
    <FrameLayout
        android:id="@+id/local_view_container"
        android:layout_width="104dp"
        android:layout_height="148dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="16dp"
        android:elevation="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/localView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/local_avatar_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E293B"
            android:visibility="gone">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/local_avatar_small"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user_placeholder" />
        </FrameLayout>

        <ImageView
            android:id="@+id/swap_indicator"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:alpha="0.7"
            android:background="@drawable/bg_swap_button"
            android:padding="4dp"
            android:src="@drawable/ic_swap_vert"
            android:visibility="gone"
            app:tint="@color/text_white" />
    </FrameLayout>

    <!-- Controls Overlay -->
    <RelativeLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top User Info Bar -->
        <LinearLayout
            android:id="@+id/top_user_info_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="#800F172A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="14dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/peer_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_user_placeholder"
                app:civ_border_color="@color/accent_primary"
                app:civ_border_width="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/peer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Connecting..."
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/connection_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_connection_dot" />

                    <TextView
                        android:id="@+id/connection_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connected"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/follow_button_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/follow_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_primary_glossy"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Follow"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Bottom Call Control Dock -->
        <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#900F172A"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">

            <ImageButton
                android:id="@+id/btnToggleVideo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_round_white"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_videocam_on"
                android:stateListAnimator="@null"
                app:tint="#0F172A" />

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_round_white"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic_on"
                android:stateListAnimator="@null"
                app:tint="#0F172A" />

            <ImageButton
                android:id="@+id/btnEnd"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_call_btn_red"
                android:elevation="6dp"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_end"
                android:stateListAnimator="@null"
                app:tint="@color/text_white" />

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_round_white"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera_flip"
                android:stateListAnimator="@null"
                app:tint="#0F172A" />

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
