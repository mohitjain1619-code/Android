<?xml version="1.0" encoding="utf-8"?>
<com.ironsource.mediationsdk.ads.nativead.NativeAdLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/levelplay_native_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_premium"
        android:orientation="vertical"
        android:padding="14dp">

    <!-- Header: Icon, Title, Advertiser, Attribution Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- App / Advertiser Icon -->
        <ImageView
            android:id="@+id/lp_native_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Ad Icon"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/lp_native_badge"
            android:layout_toEndOf="@id/lp_native_icon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lp_native_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sponsored Ad Title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lp_native_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="LevelPlay Mediation Network"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Ad Attribution Badge -->
        <TextView
            android:id="@+id/lp_native_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#2634D399"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="AD"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Body Description -->
    <TextView
        android:id="@+id/lp_native_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Native ad body description provided by the winning mediation network."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Main Media View (Image / Video) -->
    <com.ironsource.mediationsdk.ads.nativead.LevelPlayMediaView
        android:id="@+id/lp_native_media_view"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:background="#1AFFFFFF" />

    <!-- Call to Action Button -->
    <Button
        android:id="@+id/lp_native_cta"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_primary"
        android:text="Install Now"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    </LinearLayout>

</com.ironsource.mediationsdk.ads.nativead.NativeAdLayout>
