<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_glowing_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar with Ring -->
    <RelativeLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivInboxAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_1"
            app:shapeAppearanceOverlay="@style/CircleImageStyle" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_avatar_white_ring" />
    </RelativeLayout>

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInboxNameAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Applicant Name ♂️ 24 ✔️" />

        <TextView
            android:id="@+id/tvInboxSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            tools:text="📍 Gwalior • For: House Party" />

        <TextView
            android:id="@+id/tvInboxLastMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D1D1D6"
            android:textSize="12sp"
            tools:text="Tap to open 1-on-1 community chat" />
    </LinearLayout>

    <!-- Preference Badge -->
    <TextView
        android:id="@+id/tvInboxPrefBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_luxury_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FF9500"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="💬 Chat" />

</LinearLayout>
