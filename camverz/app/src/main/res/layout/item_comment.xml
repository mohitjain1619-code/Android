<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_card_luxury"
    android:padding="14dp">

    <ImageView
        android:id="@+id/comment_profile_image"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_user_placeholder" />

    <TextView
        android:id="@+id/comment_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/comment_profile_image"
        android:layout_marginStart="12dp"
        android:text="username"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/comment_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/comment_username"
        android:layout_toEndOf="@id/comment_profile_image"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:text="This is a comment"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/comment_text"
        android:layout_toEndOf="@id/comment_profile_image"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/comment_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/comment_like_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Like"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:layout_marginStart="14dp"/>

        <TextView
            android:id="@+id/comment_reply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reply"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:layout_marginStart="14dp"/>

        <TextView
            android:id="@+id/comment_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_rose"
            android:layout_marginStart="14dp"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/comment_like_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_like"
        app:tint="@color/accent_rose"
        android:visibility="gone"/>

</RelativeLayout>
