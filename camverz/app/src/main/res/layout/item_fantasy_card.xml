<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_fantasy_gradient_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: User Avatar with Magenta Ring + Name + Age + Relationship Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFantasyAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_3"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_magenta_ring" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFantasyNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Name, 22" />

            <TextView
                android:id="@+id/tvFantasyMetadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#E5E5EA"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="22 Yrs • ♀️" />

            <TextView
                android:id="@+id/tvStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_luxury_chip"
                android:letterSpacing="0.05"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#BF5AF2"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="SINGLE" />
        </LinearLayout>
    </LinearLayout>

    <!-- Interests Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="INTERESTS &amp; VIBE"
        android:textColor="#8E8E93"
        android:textSize="8sp"
        android:textStyle="bold" />

    <!-- Interests Tag -->
    <TextView
        android:id="@+id/tvInterests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E040FB"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="✨ Interests &amp; Vibe" />

    <!-- Fantasy Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MY FANTASY"
        android:textColor="#8E8E93"
        android:textSize="8sp"
        android:textStyle="bold" />

    <!-- Fantasy Quote Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_luxury_pill_dark"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvFantasyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:textColor="#F2F2F7"
            android:textSize="11sp"
            android:textStyle="italic"
            tools:text="Fantasy description text..." />
    </LinearLayout>

    <!-- Neon Magenta Secret Connect CTA Button -->
    <TextView
        android:id="@+id/btnConnectFantasy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_neon_magenta_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="9dp"
        android:text="✨ Secret Connect"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
