<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Glass Container with Premium Background -->
    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/premium_nav_bg"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Video Tab -->
        <FrameLayout
            android:id="@+id/nav_video"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/icon_video"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video"
                app:tint="#FFFFFF"/>
        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="2dp"
            android:layout_height="25dp"
            android:background="#80FFFFFF"
            android:layout_gravity="center_vertical"
            android:alpha="0.3"/>

        <!-- Image Tab -->
        <FrameLayout
            android:id="@+id/nav_image"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/icon_image"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image"
                app:tint="#AAAAAA"/>
        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="2dp"
            android:layout_height="25dp"
            android:background="#80FFFFFF"
            android:layout_gravity="center_vertical"
            android:alpha="0.3"/>

        <!-- Message Tab -->
        <FrameLayout
            android:id="@+id/nav_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/icon_message"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_message"
                app:tint="#AAAAAA"/>

            <TextView
                android:id="@+id/message_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/message_badge_background"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="2dp"
            android:layout_height="25dp"
            android:background="#80FFFFFF"
            android:layout_gravity="center_vertical"
            android:alpha="0.3"/>


        <!-- Profile Tab -->
        <FrameLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/icon_profile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="#AAAAAA"/>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
