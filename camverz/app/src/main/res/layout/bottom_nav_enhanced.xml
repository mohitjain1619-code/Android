<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="6dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/premium_nav_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Video Tab (Default Active on Main Screen) -->
        <FrameLayout
            android:id="@+id/nav_video"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/pill_video"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_capsule"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/icon_video"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video"
                app:tint="@color/nav_active_icon" />
        </FrameLayout>

        <!-- Feed Tab -->
        <FrameLayout
            android:id="@+id/nav_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/pill_image"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_capsule"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icon_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_image"
                app:tint="@color/nav_inactive_icon" />
        </FrameLayout>

        <!-- Messages Tab -->
        <FrameLayout
            android:id="@+id/nav_message"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/pill_message"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_capsule"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icon_message"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_message"
                app:tint="@color/nav_inactive_icon" />

            <TextView
                android:id="@+id/message_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/message_badge_background"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Profile Tab -->
        <FrameLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/pill_profile"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_active_capsule"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icon_profile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="@color/nav_inactive_icon" />
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
