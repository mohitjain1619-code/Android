<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0C29">

    <!-- Background Shine -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_premium_shine"
        android:alpha="0.8" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <ProgressBar
                android:id="@+id/progress3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="24dp"
                android:progress="80"
                android:max="100"
                android:progressTint="#00D9FF"
                android:backgroundTint="#33FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Where are you from?"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#8000D9FF"
            android:shadowRadius="20"
            android:layout_below="@id/topBar"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/subCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your city helps us show better matches"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:layout_below="@id/titleCity"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/locationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/subCity"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_item"
            android:padding="30dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_search_pulse"
                android:layout_marginBottom="16dp"
                android:tint="#00D9FF" />

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting City..."
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#8000D9FF"
                android:shadowRadius="10" />

            <TextView
                android:id="@+id/tvCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please wait..."
                android:textColor="#DDFFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnContinueCity"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="24dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_neon_button_pill"
            app:backgroundTint="@null"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
            
         <TextView
            android:id="@+id/backBtnCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </RelativeLayout>
</FrameLayout>