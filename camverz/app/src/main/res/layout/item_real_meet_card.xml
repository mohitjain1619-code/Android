<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_glowing_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: User Avatar + Name + Age -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_1"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />

            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_white_ring" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Name, 24" />

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                tools:text="📍 City" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimeAgo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#636366"
            android:textSize="9sp"
            tools:text="Just now" />
    </LinearLayout>

    <!-- Purpose Chip -->
    <TextView
        android:id="@+id/tvPurpose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_luxury_chip"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="9dp"
        android:paddingVertical="4dp"
        android:textColor="#F2F2F7"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="Meeting Purpose" />

    <!-- Exact Location -->
    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E5E5EA"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Meeting Location" />

    <!-- Exact Clock Time -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#8E8E93"
        android:textSize="10sp"
        tools:text="⏰ Meeting Time" />

    <!-- Description (Up to 200 chars limit) -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:textColor="#D1D1D6"
        android:textSize="11sp"
        tools:text="Meeting description..." />

    <!-- Respond / Connect Button -->
    <TextView
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tactile_btn"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="Connect"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
