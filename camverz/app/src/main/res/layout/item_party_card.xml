<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_party_gradient_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Bar: VIP Host Badge & Target Gender -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_luxury_chip"
            android:letterSpacing="0.05"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="👑 VIP PARTY HOST"
            android:textColor="#FFD60A"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTargetGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_luxury_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#34C759"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Everyone" />
    </LinearLayout>

    <!-- Host Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHostAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_2"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />

            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_gold_ring" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHostNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Host Name, 25" />

            <TextView
                android:id="@+id/tvCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFD60A"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="👥 Capacity: 15 Guests" />
        </LinearLayout>
    </LinearLayout>

    <!-- Party Title / Purpose -->
    <TextView
        android:id="@+id/tvPartyPurpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="🎉 House Party Title" />

    <!-- Venue Location -->
    <TextView
        android:id="@+id/tvPartyVenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#34C759"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="📍 Party Venue Address" />

    <!-- Party Time Glass Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_luxury_pill_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvPartyTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD60A"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="⏰ Upcoming 9:00 PM" />
    </LinearLayout>

    <!-- Neon Emerald Join Party CTA Button -->
    <TextView
        android:id="@+id/btnJoinParty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_neon_emerald_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="9dp"
        android:text="🎉 Join Party"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
