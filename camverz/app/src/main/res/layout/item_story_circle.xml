<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:gravity="center">

        <!-- Outer Purple/Pink Instagram-like glowing Ring -->
        <View
            android:id="@+id/storyRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_glowing_ring" />

        <!-- Inner Avatar Image -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivStoryAvatar"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:src="@drawable/av1"
            app:civ_border_width="2dp"
            app:civ_border_color="#0A0A0A" />

        <!-- Plus overlay for "Add Story" icon -->
        <ImageView
            android:id="@+id/ivAddStoryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@drawable/bg_neon_amber_button"
            android:padding="2dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStoryName"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="User"
        android:textColor="#E2E8F0"
        android:textSize="11sp" />
</LinearLayout>
