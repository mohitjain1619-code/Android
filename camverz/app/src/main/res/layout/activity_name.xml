<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    android:padding="24dp">

    <ProgressBar
        android:id="@+id/progress1"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progress="33"
        android:max="100"
        android:progressTint="#B34DFF"
        android:backgroundTint="#444444"
        android:layout_marginTop="30dp" />

    <ImageView
        android:id="@+id/iconName"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_person"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:tint="#B34DFF" />

    <TextView
        android:id="@+id/titleName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What's your name?"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_below="@id/iconName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp" />

    <TextView
        android:id="@+id/subName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Let others know what to call you"
        android:textColor="#DDFFFFFF"
        android:textSize="16sp"
        android:layout_below="@id/titleName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_input"
        android:hint="Enter your name"
        android:textColor="#FFFFFF"
        android:textColorHint="#88FFFFFF"
        android:padding="18dp"
        android:layout_below="@id/subName"
        android:layout_marginTop="40dp"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Continue   →"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="50dp" />

</RelativeLayout>
