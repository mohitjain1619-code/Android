<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="◀ Back"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Create Story"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPublish"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_neon_amber_button"
            android:text="Share"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null"/>
    </RelativeLayout>

    <!-- Content Creator Area -->
    <FrameLayout
        android:id="@+id/creatorCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/controlsLayout"
        android:layout_below="@id/headerBar"
        android:layout_marginVertical="12dp"
        android:background="@drawable/bg_floating_glass">

        <!-- Image/Video Preview -->
        <ImageView
            android:id="@+id/ivMediaPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/vvMediaPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Centered Text Editor / Overlay text -->
        <EditText
            android:id="@+id/etStoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:gravity="center"
            android:hint="Type something..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="20dp"
            android:maxLength="200" />
    </FrameLayout>

    <!-- Controls panel -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- Type Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTypeText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_luxury_chip"
                android:text="Text"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnTypeImage"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_luxury_pill_dark"
                android:text="Image"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null"/>

            <Button
                android:id="@+id/btnTypeVideo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_luxury_pill_dark"
                android:text="Video"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null"/>
        </LinearLayout>

        <!-- Dynamic controls based on selection -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <!-- Text custom colors and background selector -->
            <LinearLayout
                android:id="@+id/textOptionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theme:"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"/>

                <View
                    android:id="@+id/themePurple"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_community_hot_gradient"
                    android:layout_marginHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:id="@+id/themeAmber"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_neon_amber_button"
                    android:layout_marginHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:id="@+id/themeCyan"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="#00E5FF"
                    android:layout_marginHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:id="@+id/themeDark"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="#1A1A1A"
                    android:layout_marginHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Media attachment selector button -->
            <Button
                android:id="@+id/btnSelectFile"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_primary_gradient"
                android:text="🖼️ Select File from Gallery"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone"
                app:backgroundTint="@null"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
