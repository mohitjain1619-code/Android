<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- CameraX Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Oval Frame Overlay -->
    <com.mohitt.camverz.OvalFrameView
        android:id="@+id/oval_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Instructions Overlay -->
    <FrameLayout
        android:id="@+id/instructions_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Arrow Instruction -->
        <LinearLayout
            android:id="@+id/arrow_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="50dp">

            <TextView
                android:id="@+id/instruction_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOOK FRONT"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/accent_primary"
                android:layout_marginBottom="16dp"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/arrow_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/accent_primary" />
        </LinearLayout>

        <!-- Countdown Circle -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/countdown_container"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/bg_glass_card_luxury"
                android:visibility="gone">

                <TextView
                    android:id="@+id/countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_primary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Progress Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Step Indicators -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/step_1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_btn_primary_gradient"
                    android:elevation="4dp" />
            </LinearLayout>

            <!-- Progress Text -->
            <TextView
                android:id="@+id/progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep your face steady inside the frame"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

    <!-- Results Screen -->
    <FrameLayout
        android:id="@+id/results_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Header -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <FrameLayout
                        android:id="@+id/back_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/bg_glass_card_luxury"
                        android:layout_gravity="start">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_arrow_back"
                            app:tint="@color/text_primary"
                            android:contentDescription="Back" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verification Complete"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp" />
                </FrameLayout>

                <!-- Success Message -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card_luxury"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Liveness check passed!"
                        android:textColor="@color/accent_emerald"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Face image captured successfully. Verify details to complete your application."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Captured Image -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="20dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_card_luxury">

                        <ImageView
                            android:id="@+id/image_front"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Front face" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:text="FRONT PHOTO"
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:background="#66000000" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Verify Gender Button -->
                <Button
                    android:id="@+id/verify_gender_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_glass_card_luxury"
                    android:text="Verify Gender Match"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@null" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/submit_verification_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_btn_primary_gradient"
                    android:text="Confirm &amp; Submit Verification"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:layout_marginBottom="12dp"
                    app:backgroundTint="@null" />

                <!-- Retake Button -->
                <Button
                    android:id="@+id/retake_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_glass_card_luxury"
                    android:text="Retake Photo"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
