<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glowing_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Avatar + Poster Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFullAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_1"
                app:shapeAppearanceOverlay="@style/CircleImageStyle" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_avatar_white_ring" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFullNameAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Mohit ♂️ 24 ✔️" />

            <TextView
                android:id="@+id/tvFullSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                tools:text="📍 Gwalior • Real Meet Post" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseFullDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_luxury_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#1A1A24" />

    <!-- Full Purpose / Title -->
    <TextView
        android:id="@+id/tvFullTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF9500"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Purpose Title" />

    <!-- Full Location & Time Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_luxury_pill_dark"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvFullVenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#34C759"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="📍 Venue Address" />

        <TextView
            android:id="@+id/tvFullTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFD60A"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="⏰ Time: 8:00 PM" />
    </LinearLayout>

    <!-- Complete Untruncated Description Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.05"
        android:text="FULL DETAILS &amp; DESCRIPTION"
        android:textColor="#8E8E93"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxHeight="200dp">

        <TextView
            android:id="@+id/tvFullDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="#F2F2F7"
            android:textSize="13sp"
            tools:text="Full untruncated description text goes here..." />
    </ScrollView>

    <TextView
        android:id="@+id/tvFullTargetAudience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_luxury_pill_dark"
        android:padding="8dp"
        android:gravity="center"
        android:textColor="#34C759"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="🎯 Preferred Audience: Female Only" />

    <!-- Action Button in Full Dialog -->
    <TextView
        android:id="@+id/btnFullDialogAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_neon_amber_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="⚡ Send Request"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
