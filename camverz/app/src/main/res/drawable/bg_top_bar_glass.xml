<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#CC000000"
                android:endColor="#88000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Glass shine effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#3300E5FF"
                android:centerColor="#1100E5FF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Border -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#4400E5FF" />
        </shape>
    </item>
</layer-list>
