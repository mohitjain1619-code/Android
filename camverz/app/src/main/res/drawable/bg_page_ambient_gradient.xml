<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base soft background -->
    <item>
        <color android:color="@color/bg_primary" />
    </item>

    <!-- Top-left to bottom-right subtle ambient light layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/bg_ambient_start"
                android:centerColor="#00FFFFFF"
                android:endColor="@color/bg_ambient_end"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
