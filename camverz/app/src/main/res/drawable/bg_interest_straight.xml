<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FF6B00">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="45"
                        android:startColor="#FFFFFBF5"
                        android:endColor="#FFFFF2E6"
                        android:type="linear" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#20FF6B00" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
