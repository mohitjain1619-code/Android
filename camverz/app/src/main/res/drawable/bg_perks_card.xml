<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2A54D6D2"
                android:endColor="#2AA78BFA"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#121422" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>

