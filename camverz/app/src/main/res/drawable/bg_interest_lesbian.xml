<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20F43F5E">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="45"
                        android:startColor="#FFFFF5F7"
                        android:endColor="#FFFCE7F3"
                        android:type="linear" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#20F43F5E" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
