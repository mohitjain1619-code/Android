<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The outer glow gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00C2FF"
                android:centerColor="#8A2BE2"
                android:endColor="#FF00FF"
                android:type="linear" />
        </shape>
    </item>
    <!-- The inner dark glass part, inset to create the border effect -->
    <item android:left="0.5dp" android:right="0.5dp" android:top="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#D01A1A2E" />
        </shape>
    </item>
    <!-- Glossy Highlight Overlay -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#80FFFFFF"
                android:centerColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <!-- Adding a second, sharper highlight for a more 3D feel -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="50dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A0FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
