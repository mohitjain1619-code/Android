<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#4400E5FF"
                android:centerColor="#44FF00FF"
                android:endColor="#4400E5FF"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glass background -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#88000000" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
