<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow effect shadow layer -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#4400D9FF" />
        </shape>
    </item>
    <!-- Main gradient button -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:startColor="#00D9FF"
                android:centerColor="#0080FF"
                android:endColor="#6000FF" />
        </shape>
    </item>
</layer-list>
