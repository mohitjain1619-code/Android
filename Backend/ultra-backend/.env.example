# Environment Configuration for Camverz Backend
# Copy this to .env and fill in your values
# Same file works on local Docker AND Hetzner VPS

# ============================================
# PostgreSQL
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=camverz
POSTGRES_USER=camverz
POSTGRES_PASSWORD=camverz_dev_2024

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=camverz-jwt-super-secret-change-in-production-2024
JWT_EXPIRY=30d

# ============================================
# Google OAuth (for verifying Android/Web tokens)
# Get from Firebase Console > Project Settings > Web app
# ============================================
GOOGLE_CLIENT_ID=973141718708-xxxxxxxxxxxx.apps.googleusercontent.com

# ============================================
# AWS Rekognition (Gender Verification)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_MIN_CONFIDENCE=80

# ============================================
# Coturn (WebRTC TURN/STUN)
# ============================================
TURN_ENABLED=true
TURN_USER=camverz
TURN_PASS=camverz_turn_2024
TURN_REALM=camverz.com
TURN_PORT=3478
TURN_TLS_PORT=5349

# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Domain (change for production)
# ============================================
DOMAIN=localhost
API_URL=http://localhost:3000

# ============================================
# Razorpay (Payment Processing)
# Get from Razorpay Dashboard > Account & Settings > Webhooks
# ============================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard
